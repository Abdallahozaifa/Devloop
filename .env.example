# DevLoop Environment Variables
# Copy to .env and update values

# Application
APP_NAME=DevLoop
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devloop

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
LICENSE_SECRET=your-license-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# Email (for magic links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@devloop.dev
SMTP_FROM_NAME=DevLoop

# URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# NPM (for publishing)
NPM_TOKEN=npm_...

# Anthropic (for AI vision checks)
ANTHROPIC_API_KEY=sk-ant-...
